# Токен бота от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую
ADMIN_IDS=
# Путь к файлу SQLite
DB_PATH=data/bot.db
# Ключ Steam Web API (https://steamcommunity.com/dev/apikey), нужен для профилей Steam
STEAM_API_KEY=
# Публичный HTTPS URL веб-приложения для Telegram Mini App (пусто = кнопка не показывается)
WEB_APP_URL=
# Токен доступа к /admin и /stats веб-приложения (пусто = разделы отключены)
WEB_ADMIN_TOKEN=
# Сколько секунд держать кэш каталога в памяти веб-процесса (пусто = 60, 0 = без кэша)
WEB_CACHE_TTL=
# Прокси для Telegram Bot API, если прямой доступ заблокирован: http://user:pass@host:port
# Для socks5 нужен пакет aiohttp-socks: socks5://user:pass@host:port
TELEGRAM_PROXY=
# Ключ LLM для ИИ-разбора запросов «хочу» (пусто = фолбэк выключен)
LLM_API_KEY=
# OpenAI-совместимый адрес API (пусто = https://api.openai.com/v1)
LLM_BASE_URL=
# Модель для разбора запроса (пусто = gpt-4o-mini)
LLM_MODEL=
# Таймаут запроса к LLM в секундах (пусто = 10)
LLM_TIMEOUT=
